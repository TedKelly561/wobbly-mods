<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- BepInEx 5 Unity Mono plugins (Steam build) -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>WobblyMods.HouseMenu</AssemblyName>
    <RootNamespace>WobblyMods.HouseMenu</RootNamespace>
    <Description>Wobbly Life house decorating menu (BepInEx 5, Steam)</Description>

    <!-- Your game folder. Override on the command line if it differs:
         dotnet build -p:GameDir="D:\Games\Wobbly Life" -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Wobbly Life</GameDir>
    <ManagedDir Condition="'$(ManagedDir)' == ''">$(GameDir)\Wobbly Life_Data\Managed</ManagedDir>

    <!-- Copy the built DLL into BepInEx\plugins after each build. Use -p:DeployToGame=false to skip. -->
    <DeployToGame Condition="'$(DeployToGame)' == ''">true</DeployToGame>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ManagedDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Fail early with a clear message if the game or BepInEx is missing -->
  <Target Name="CheckGameInstall" BeforeTargets="Build">
    <Error Condition="!Exists('$(GameDir)\BepInEx\core\BepInEx.dll')"
           Text="BepInEx 5 not found at '$(GameDir)'. Install BepInEx 5 into the game folder, or pass -p:GameDir=&quot;...&quot;." />
    <Error Condition="!Exists('$(ManagedDir)\UnityEngine.CoreModule.dll')"
           Text="Unity DLLs not found at '$(ManagedDir)'. Check the 'Wobbly Life_Data\Managed' folder name, or pass -p:ManagedDir=&quot;...&quot;." />
  </Target>

  <Target Name="DeployToGame" AfterTargets="Build"
          Condition="'$(DeployToGame)' == 'true' And Exists('$(GameDir)\BepInEx\plugins')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\plugins\WobblyMods" />
  </Target>

</Project>
